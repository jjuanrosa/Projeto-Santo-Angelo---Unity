    - target: {fileID: 8908833148325884413, guid: fd28f23af44f73f4a95e33435872ad15, type: 3}
      propertyPath: m_Text
      value: "A arquitetura do Trapiche Santo \xC2ngelo preserva caracter\xEDsticas
        do per\xEDodo colonial portugu\xEAs.\nAs constru\xE7\xF5es utilizam paredes
        largas, estruturas resistentes e elementos adaptados ao clima tropical.\nHoje,
        o complexo faz parte da mem\xF3ria hist\xF3rica e cultural de S\xE3o Lu\xEDs."
      objectReference: {fileID: 0}
