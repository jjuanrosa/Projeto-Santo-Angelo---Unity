    - target: {fileID: 8908833148325884413, guid: fd28f23af44f73f4a95e33435872ad15, type: 3}
      propertyPath: m_Text
      value: "Preservar espa\xE7os hist\xF3ricos \xE9 manter viva a mem\xF3ria de
        um povo.\nO Complexo Trapiche Santo \xC2ngelo representa n\xE3o apenas o
        passado comercial de S\xE3o Lu\xEDs, mas tamb\xE9m a resist\xEAncia cultural
        e a valoriza\xE7\xE3o do patrim\xF4nio maranhense.\nQue esta visita inspire
        novas gera\xE7\xF5es a conhecer e proteger sua hist\xF3ria."
      objectReference: {fileID: 0}
