    - target: {fileID: 8908833148325884413, guid: fd28f23af44f73f4a95e33435872ad15, type: 3}
      propertyPath: m_Text
      value: "Durante muitos anos, S\xE3o Lu\xEDs foi um importante centro comercial
        mar\xEDtimo.\nO porto recebia embarca\xE7\xF5es de diferentes partes do mundo,
        movimentando produtos agr\xEDcolas e fortalecendo a economia maranhense.\nO
        trapiche servia como ponto de armazenamento e distribui\xE7\xE3o das mercadorias."
      objectReference: {fileID: 0}
